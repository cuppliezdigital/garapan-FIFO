NODE_ENV=production
PORT=3000
CLIENT_URL=https://monitoring.example.com
DB_HOST=127.0.0.1
DB_USER=monitoring_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=db_monitoring_fifo
JWT_SECRET=generate_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30m
ALLOW_DEFAULT_ADMIN=false
# Only set these temporarily when provisioning the first admin.
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_password
